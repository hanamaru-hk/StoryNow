{
  "client_id": "instant-visual-novel",
  "prompt": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "__MODEL_FILENAME__"
      }
    },
    "2": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["1", 0],
        "positive": ["3", 0],
        "negative": ["6", 0],
        "latent_image": ["7", 0],
        "seed": __SEED__,
        "steps": 25,
        "cfg": 4,
        "sampler_name": "dpmpp_2m_sde_gpu",
        "scheduler": "simple",
        "denoise": 1
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["1", 1],
        "text": "score_9, score_8_up, score_7_up, masterpiece, __POSITIVE_PROMPT__"
      }
    },
    "4": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["2", 0],
        "vae": ["1", 2]
      }
    },
    "5": {
      "class_type": "SaveImage",
      "inputs": {
        "images": ["4", 0],
        "filename_prefix": "__FILENAME_PREFIX__"
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["1", 1],
        "text": "(monster:1.5),__NEGATIVE_PROMPT__"
      }
    },
    "7": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": __IMAGE_WIDTH__,
        "height": __IMAGE_HEIGHT__,
        "batch_size": 1
      }
    }
  },
  "extra_data": {}
}
