[configuration]

entry_symbol = "sherpa_tts_library_init"
compatibility_minimum = "4.3"
reloadable = false

[libraries]

windows.debug.x86_64 = "res://addons/sherpa_tts/bin/sherpa_tts.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/sherpa_tts/bin/sherpa_tts.windows.template_release.x86_64.dll"

[dependencies]

windows.debug.x86_64 = {
    "res://addons/sherpa_tts/bin/sherpa-onnx-c-api.dll": "",
    "res://addons/sherpa_tts/bin/onnxruntime.dll": "",
    "res://addons/sherpa_tts/bin/onnxruntime_providers_shared.dll": ""
}
windows.release.x86_64 = {
    "res://addons/sherpa_tts/bin/sherpa-onnx-c-api.dll": "",
    "res://addons/sherpa_tts/bin/onnxruntime.dll": "",
    "res://addons/sherpa_tts/bin/onnxruntime_providers_shared.dll": ""
}
