[sub_resource type="Shader" id="Shader_left_black_fade"]
code = "shader_type canvas_item;

void fragment() {
	COLOR = vec4(0.0, 0.0, 0.0, COLOR.a * (1.0 - UV.x));
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_left_black_fade"]
shader = SubResource("Shader_left_black_fade")

[sub_resource type="Shader" id="Shader_logo_glow"]
code = "shader_type canvas_item;

uniform vec4 glow_color : source_color = vec4(1.0, 1.0, 1.0, 0.24);

void fragment() {
	vec2 p = abs(UV * 2.0 - 1.0);
	float edge_distance = length(max(p - vec2(0.68, 0.24), vec2(0.0)));
	float softness = 1.0 - smoothstep(0.0, 0.32, edge_distance);
	COLOR = vec4(glow_color.rgb, glow_color.a * softness);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_logo_glow"]
shader = SubResource("Shader_logo_glow")

[sub_resource type="Shader" id="Shader_logo_gradient"]
code = "shader_type canvas_item;

uniform vec4 top_color : source_color = vec4(0.06, 0.18, 0.45, 1.0);
uniform vec4 bottom_color : source_color = vec4(0.04, 0.36, 0.27, 1.0);
varying float label_y;

void vertex() {
	label_y = VERTEX.y;
}

void fragment() {
	vec4 glyph = texture(TEXTURE, UV);
	float gradient_position = smoothstep(20.0, 180.0, label_y);
	vec4 gradient_color = mix(top_color, bottom_color, gradient_position);
	COLOR = glyph * gradient_color * COLOR;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_logo_gradient"]
shader = SubResource("Shader_logo_gradient")

