; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="StoryNow"
config/icon="res://assets/images/logo.png"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/auto_accept_quit=false

[autoload]

AppPaths="*res://scripts/app_paths.gd"
I18n="*res://scripts/i18n.gd"
GameSettingsManager="*res://scripts/game_settings_manager.gd"
ImageServerSettingsManager="*res://scripts/image_server_settings_manager.gd"
LLMSettingsManager="*res://scripts/llm_settings_manager.gd"
LLMManager="*res://scripts/llm_manager.gd"
ImageServerManager="*res://scripts/image_server_manager.gd"
ServerRuntimeManager="*res://scripts/server_runtime_manager.gd"
SceneDataManager="*res://scripts/scene_data_manager.gd"
GameProgressManager="*res://scripts/game_progress_manager.gd"
TTSManager="*res://scripts/tts_manager.gd"
MusicManager="*res://scripts/music_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
