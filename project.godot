; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited via text.

[application]

config/name="Instant Visual Novel"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")

[autoload]

I18n="*res://scripts/i18n.gd"
GameSettingsManager="*res://scripts/game_settings_manager.gd"
ImageServerSettingsManager="*res://scripts/image_server_settings_manager.gd"
LLMSettingsManager="*res://scripts/llm_settings_manager.gd"
LLMManager="*res://scripts/llm_manager.gd"
ImageServerManager="*res://scripts/image_server_manager.gd"
ServerRuntimeManager="*res://scripts/server_runtime_manager.gd"
SceneDataManager="*res://scripts/scene_data_manager.gd"
GameProgressManager="*res://scripts/game_progress_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://data/theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
